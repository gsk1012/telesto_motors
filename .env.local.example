# --- Instagram feed (via Behold.so) -----------------------------------------
# JSON-feed-URL uit je Behold-dashboard (Feeds → jouw feed → JSON Feed).
# Zonder deze variabele valt de Instagram-wall terug op de lokale
# afbeeldingen in public/images/instagram/.
BEHOLD_FEED_URL=

# --- Contactformulier (via Resend) -------------------------------------------
# API-sleutel van resend.com (API Keys). Het domein telestomotors.nl moet daar
# geverifieerd zijn (DNS-records in GoDaddy), anders weigert Resend de afzender.
RESEND_API_KEY=
# Optioneel; standaardwaarden hieronder.
# CONTACT_TO=info@telestomotors.nl
# CONTACT_FROM=Telesto Motors <noreply@telestomotors.nl>
